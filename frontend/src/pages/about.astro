---
import MainLayout from '../layouts/MainLayout.astro';
import { url } from '../lib/paths';
---

<MainLayout title="About SAVRIVO — Smart Finds. Better Choices." description="Learn what SAVRIVO is, how product discovery works, and how we earn through affiliate commissions." canonicalUrl="https://savrivo.in/about">
  <div class="section">
    <div class="container-content max-w-3xl">
      <nav class="text-xs mb-6" style="color: var(--color-text-2)">
        <a href={url('/')} class="hover:underline">Home</a> <span class="mx-2">›</span>
        <span style="color: var(--color-text-1)">About</span>
      </nav>
      <h1 class="font-display text-3xl md:text-4xl font-bold mb-6" style="color: var(--color-text-1)">About SAVRIVO</h1>

      <div class="prose prose-base max-w-none space-y-6" style="color: var(--color-text-2)">
        <section>
          <h2 style="color: var(--color-text-1)">What is SAVRIVO?</h2>
          <p>SAVRIVO is an independent product discovery platform for India. We help you discover curated products across trusted retailers — think of us as your research companion, not a store.</p>
          <p><strong style="color: var(--color-text-1)">SAVRIVO is not an e-commerce store.</strong> We do not sell products, accept payments, process orders, handle deliveries, or manage returns. All transactions happen directly on the retailer's official website.</p>
        </section>

        <section>
          <h2 style="color: var(--color-text-1)">How Product Discovery Works</h2>
          <ol>
            <li><strong style="color: var(--color-text-1)">We research.</strong> Our editorial team selects and documents products based on category relevance and usefulness — not paid placements.</li>
            <li><strong style="color: var(--color-text-1)">You discover.</strong> Browse, filter, and read about products in one place with consistent, honest information.</li>
            <li><strong style="color: var(--color-text-1)">You buy at the official store.</strong> Clicking "Shop Now" takes you directly to the retailer's official product page. We are transparent about which retailer you are visiting.</li>
          </ol>
        </section>

        <section>
          <h2 style="color: var(--color-text-1)">Our Independence</h2>
          <p>SAVRIVO is editorially independent. We are not affiliated with, owned by, or endorsed by Amazon, Flipkart, or any other retailer. Our affiliate relationships are disclosed on every relevant page.</p>
        </section>

        <section>
          <h2 style="color: var(--color-text-1)">How We Earn Revenue</h2>
          <p>SAVRIVO participates in affiliate programmes such as Amazon Associates. When you click a link and make a qualifying purchase, we may earn a small commission at no extra cost to you. This commission supports our editorial work and keeps the platform free to use.</p>
          <p>Our editorial recommendations are not influenced by affiliate relationships. Read our <a href={url('/affiliate-disclosure')} style="color: var(--color-accent)">full affiliate disclosure</a> and <a href={url('/editorial-policy')} style="color: var(--color-accent)">editorial policy</a>.</p>
        </section>

        <section>
          <h2 style="color: var(--color-text-1)">Contact Us</h2>
          <p>Have feedback, a question, or want to suggest a product category? <a href={url('/contact')} style="color: var(--color-accent)">Get in touch</a>.</p>
        </section>
      </div>
    </div>
  </div>
</MainLayout>

