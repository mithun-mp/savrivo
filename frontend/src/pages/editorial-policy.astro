---
import MainLayout from '../layouts/MainLayout.astro';
import { url } from '../lib/paths';
---

<MainLayout title="Editorial Policy — SAVRIVO" description="SAVRIVO's editorial policy. How we select and review products." canonicalUrl="https://savrivo.in/editorial-policy">
  <div class="section">
    <div class="container-content max-w-3xl">
      <nav class="text-xs mb-6" style="color: var(--color-text-2)">
        <a href={url('/')} class="hover:underline">Home</a> <span class="mx-2">›</span>
        <span style="color: var(--color-text-1)">Editorial Policy</span>
      </nav>
      <h1 class="font-display text-3xl font-bold mb-8" style="color: var(--color-text-1)">Editorial Policy</h1>
      <div class="prose prose-base max-w-none space-y-5" style="color: var(--color-text-2)">
        <p><strong style="color: var(--color-text-1)">Last updated: November 2024</strong></p>
        <h2 style="color: var(--color-text-1)">How We Select Products</h2>
        <p>Products on SAVRIVO are selected by our editorial team based on category relevance, usefulness, and quality of available information. We do not accept payment for editorial product placement.</p>
        <h2 style="color: var(--color-text-1)">Buying Guides</h2>
        <p>Buying guides are written to provide genuinely useful purchase guidance. They are based on publicly available specifications and feature information. We do not fabricate test results.</p>
        <h2 style="color: var(--color-text-1)">Affiliate Relationships and Independence</h2>
        <p>While SAVRIVO earns affiliate commissions, our editorial decisions are independent. Affiliate commission rates do not influence which products we feature or how we describe them.</p>
        <h2 style="color: var(--color-text-1)">Accuracy</h2>
        <p>We aim for accuracy in all product information. Where information may be outdated, we indicate when it was last verified. We do not invent specifications, ratings, or prices.</p>
        <h2 style="color: var(--color-text-1)">Corrections</h2>
        <p>If you spot an error, please <a href={url('/contact')} style="color: var(--color-accent)">contact us</a>. We will review and correct factual errors promptly.</p>
      </div>
    </div>
  </div>
</MainLayout>

