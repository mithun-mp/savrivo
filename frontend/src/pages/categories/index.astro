---
import MainLayout from '../../layouts/MainLayout.astro';
import CategoryCard from '../../components/category/CategoryCard';
import { url } from '../../lib/paths';
import type { Category } from '../../types';

const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:4000/api';
let categories: Category[] = [];
try {
  const res = await fetch(`${API_BASE}/categories`, { signal: AbortSignal.timeout(5000) });
  if (res.ok) { const json = await res.json(); categories = json.data || []; }
} catch {}
---

<MainLayout title="Categories — SAVRIVO" description="Browse all product categories on SAVRIVO." canonicalUrl="https://savrivo.in/categories">
  <div class="section">
    <div class="container-content">
      <nav class="text-xs mb-4" style="color: var(--color-text-2)">
        <a href={url('/')} class="hover:underline">Home</a> <span class="mx-2">›</span>
        <span style="color: var(--color-text-1)">Categories</span>
      </nav>
      <h1 class="font-display text-3xl md:text-4xl font-bold mb-3" style="color: var(--color-text-1)">Categories</h1>
      <p class="text-base mb-10" style="color: var(--color-text-2)">Browse products by category.</p>
      {categories.length > 0 ? (
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5">
          {categories.map(cat => <CategoryCard category={cat} />)}
        </div>
      ) : (
        <p class="text-sm" style="color: var(--color-text-2)">Categories are being set up. Check back soon.</p>
      )}
    </div>
  </div>
</MainLayout>

