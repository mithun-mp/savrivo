---
import MainLayout from '../layouts/MainLayout.astro';
import { url } from '../lib/paths';
---

<MainLayout title="Privacy Policy — SAVRIVO" description="SAVRIVO's privacy policy. Learn how we handle your data." canonicalUrl="https://savrivo.in/privacy-policy">
  <div class="section">
    <div class="container-content max-w-3xl">
      <nav class="text-xs mb-6" style="color: var(--color-text-2)">
        <a href={url('/')} class="hover:underline">Home</a> <span class="mx-2">›</span>
        <span style="color: var(--color-text-1)">Privacy Policy</span>
      </nav>
      <h1 class="font-display text-3xl font-bold mb-8" style="color: var(--color-text-1)">Privacy Policy</h1>
      <div class="prose prose-base max-w-none space-y-5" style="color: var(--color-text-2)">
        <p><strong style="color: var(--color-text-1)">Last updated: November 2024</strong></p>
        <p>SAVRIVO ("we", "us", "our") is committed to protecting your privacy. This policy explains what information we collect, how we use it, and your rights.</p>

        <h2 style="color: var(--color-text-1)">Information We Collect</h2>
        <ul>
          <li><strong style="color: var(--color-text-1)">Contact form submissions:</strong> If you use our contact form, we collect your name, email address, and message. We use this only to respond to your enquiry.</li>
          <li><strong style="color: var(--color-text-1)">Theme preference:</strong> We store your light/dark theme preference in your browser's localStorage. This stays on your device.</li>
          <li><strong style="color: var(--color-text-1)">Analytics (if applicable):</strong> We may use privacy-respecting analytics to understand aggregate page traffic. We do not use Google Analytics or other invasive tracking tools without disclosure.</li>
        </ul>

        <h2 style="color: var(--color-text-1)">What We Do Not Collect</h2>
        <ul>
          <li>Payment or financial information (we have no checkout).</li>
          <li>Personal accounts or registration data (no sign-up).</li>
          <li>Browsing history beyond what any website server log captures.</li>
        </ul>

        <h2 style="color: var(--color-text-1)">Affiliate Links and Third Parties</h2>
        <p>When you click an affiliate link and visit a retailer's website, that retailer's own privacy policy applies. We have no control over data collected by retailers.</p>

        <h2 style="color: var(--color-text-1)">Contact</h2>
        <p>For privacy questions, email us at <a href="mailto:hello@savrivo.in" style="color: var(--color-accent)">hello@savrivo.in</a>.</p>
      </div>
    </div>
  </div>
</MainLayout>

