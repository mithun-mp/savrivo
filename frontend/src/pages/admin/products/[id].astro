---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { url } from '../../../lib/paths';

export async function getStaticPaths() {
  return [{ params: { id: 'edit' } }];
}
---

<AdminLayout title="Edit Product">
  <div class="max-w-3xl space-y-8">
    <div>
      <a href={url('/admin/products')} class="text-xs hover:underline" style="color: var(--color-text-2)">← Back to Products</a>
      <h1 class="text-xl font-bold mt-2" style="color: var(--color-text-1)">Edit Product</h1>
    </div>

    <form id="edit-product-form" class="space-y-6">
      <div class="p-6 rounded-xl border space-y-4" style="background: var(--color-surface); border-color: var(--color-border)">
        <h2 class="text-sm font-semibold uppercase tracking-wider" style="color: var(--color-text-1)">Core Information</h2>

        <div>
          <label class="block text-xs font-semibold mb-1" style="color: var(--color-text-1)">Product Title *</label>
          <input type="text" id="title" required class="w-full px-4 py-2.5 rounded-lg border text-sm outline-none" style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold mb-1" style="color: var(--color-text-1)">Brand *</label>
            <input type="text" id="brand" required class="w-full px-4 py-2.5 rounded-lg border text-sm outline-none" style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)" />
          </div>
          <div>
            <label class="block text-xs font-semibold mb-1" style="color: var(--color-text-1)">Status</label>
            <select id="status" class="w-full px-4 py-2.5 rounded-lg border text-sm outline-none" style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)">
              <option value="draft">Draft</option>
              <option value="published">Published</option>
              <option value="archived">Archived</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold mb-1" style="color: var(--color-text-1)">Short Description</label>
          <textarea id="shortDescription" rows="2" class="w-full px-4 py-2.5 rounded-lg border text-sm outline-none" style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold mb-1" style="color: var(--color-text-1)">Full Description (HTML)</label>
          <textarea id="fullDescription" rows="6" class="w-full px-4 py-2.5 rounded-lg border text-sm outline-none font-mono text-xs" style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"></textarea>
        </div>

        <div class="flex items-center gap-2">
          <input type="checkbox" id="featured" class="w-4 h-4 rounded" />
          <label for="featured" class="text-sm font-medium" style="color: var(--color-text-1)">Feature as Editor's Pick</label>
        </div>
      </div>

      <div id="form-msg" class="hidden text-xs p-3 rounded-lg"></div>

      <div class="flex items-center gap-3">
        <button
          type="submit"
          id="save-btn"
          class="px-6 py-3 rounded-xl font-semibold text-sm text-white transition-opacity hover:opacity-90"
          style="background: var(--color-accent)"
        >
          Update Product
        </button>
        <a href={url('/admin/products')} class="px-5 py-3 rounded-xl border text-sm font-medium" style="border-color: var(--color-border); color: var(--color-text-2)">
          Back
        </a>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  import { api } from '../../../lib/api';

  const pathParts = window.location.pathname.split('/');
  const idFromPath = pathParts[pathParts.length - 1] || pathParts[pathParts.length - 2];
  const urlParams = new URLSearchParams(window.location.search);
  const productId = urlParams.get('id') || (idFromPath !== 'edit' ? idFromPath : '');

  async function load() {
    if (!productId) return;
    try {
      const res: any = await api.admin.products.get(productId);
      const p = res.data;
      if (p) {
        (document.getElementById('title') as HTMLInputElement).value = p.title || '';
        (document.getElementById('brand') as HTMLInputElement).value = p.brand || '';
        (document.getElementById('shortDescription') as HTMLTextAreaElement).value = p.shortDescription || '';
        (document.getElementById('fullDescription') as HTMLTextAreaElement).value = p.fullDescription || '';
        (document.getElementById('status') as HTMLSelectElement).value = p.status || 'draft';
        (document.getElementById('featured') as HTMLInputElement).checked = !!p.featured;
      }
    } catch (err) {
      console.error(err);
    }
  }

  const form = document.getElementById('edit-product-form') as HTMLFormElement;
  const msgEl = document.getElementById('form-msg') as HTMLDivElement;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!productId) return;
      saveBtn.disabled = true;
      saveBtn.textContent = 'Updating...';

      const updateData = {
        title: (document.getElementById('title') as HTMLInputElement).value,
        brand: (document.getElementById('brand') as HTMLInputElement).value,
        shortDescription: (document.getElementById('shortDescription') as HTMLTextAreaElement).value,
        fullDescription: (document.getElementById('fullDescription') as HTMLTextAreaElement).value,
        status: (document.getElementById('status') as HTMLSelectElement).value,
        featured: (document.getElementById('featured') as HTMLInputElement).checked,
      };

      try {
        const res = await api.admin.products.update(productId, updateData);
        if (res.success) {
          msgEl.className = 'block text-xs p-3 rounded-lg text-emerald-800 bg-emerald-50 border border-emerald-200';
          msgEl.textContent = 'Product updated successfully!';
        } else {
          throw new Error(res.message);
        }
      } catch (err: any) {
        msgEl.className = 'block text-xs p-3 rounded-lg text-red-800 bg-red-50 border border-red-200';
        msgEl.textContent = err.message || 'Update failed';
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Update Product';
      }
    });
  }

  load();
</script>

