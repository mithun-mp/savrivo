---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Add Product">
  <div class="max-w-3xl space-y-8">
    <div>
      <a href="/admin/products" class="text-xs hover:underline" style="color: var(--color-text-2)">← Back to Products</a>
      <h1 class="text-xl font-bold mt-2" style="color: var(--color-text-1)">Create New Product</h1>
      <p class="text-xs" style="color: var(--color-text-2)">Fill in verified product information. No fabricated specs or ratings.</p>
    </div>

    <form id="product-form" class="space-y-6">
      <div class="p-6 rounded-xl border space-y-4" style="background: var(--color-surface); border-color: var(--color-border)">
        <h2 class="text-sm font-semibold uppercase tracking-wider" style="color: var(--color-text-1)">Core Information</h2>

        <div>
          <label class="block text-xs font-semibold mb-1" style="color: var(--color-text-1)">Product Title *</label>
          <input type="text" id="title" required placeholder="e.g. Sony WH-1000XM5 Wireless Headphones" class="w-full px-4 py-2.5 rounded-lg border text-sm outline-none" style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold mb-1" style="color: var(--color-text-1)">Brand *</label>
            <input type="text" id="brand" required placeholder="e.g. Sony" class="w-full px-4 py-2.5 rounded-lg border text-sm outline-none" style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)" />
          </div>
          <div>
            <label class="block text-xs font-semibold mb-1" style="color: var(--color-text-1)">Category</label>
            <select id="categoryId" class="w-full px-4 py-2.5 rounded-lg border text-sm outline-none" style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)">
              <option value="">Select Category</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold mb-1" style="color: var(--color-text-1)">Short Description (max 300 chars)</label>
          <textarea id="shortDescription" rows="2" placeholder="Brief summary of what this product is and who it suits." class="w-full px-4 py-2.5 rounded-lg border text-sm outline-none" style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold mb-1" style="color: var(--color-text-1)">Full Editorial Description (HTML supported)</label>
          <textarea id="fullDescription" rows="5" placeholder="Detailed product overview, features, pros and cons." class="w-full px-4 py-2.5 rounded-lg border text-sm outline-none font-mono text-xs" style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"></textarea>
        </div>
      </div>

      <div class="p-6 rounded-xl border space-y-4" style="background: var(--color-surface); border-color: var(--color-border)">
        <h2 class="text-sm font-semibold uppercase tracking-wider" style="color: var(--color-text-1)">Media & Highlights</h2>

        <div>
          <label class="block text-xs font-semibold mb-1" style="color: var(--color-text-1)">Main Image URL</label>
          <input type="url" id="imageUrl" placeholder="https://..." class="w-full px-4 py-2.5 rounded-lg border text-sm outline-none" style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)" />
        </div>

        <div>
          <label class="block text-xs font-semibold mb-1" style="color: var(--color-text-1)">Key Highlights (one per line)</label>
          <textarea id="highlights" rows="3" placeholder="Industry-leading noise cancellation&#10;30-hour battery life&#10;Multipoint Bluetooth connection" class="w-full px-4 py-2.5 rounded-lg border text-sm outline-none" style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"></textarea>
        </div>
      </div>

      <div class="p-6 rounded-xl border space-y-4" style="background: var(--color-surface); border-color: var(--color-border)">
        <h2 class="text-sm font-semibold uppercase tracking-wider" style="color: var(--color-text-1)">Publishing & SEO</h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold mb-1" style="color: var(--color-text-1)">Status</label>
            <select id="status" class="w-full px-4 py-2.5 rounded-lg border text-sm outline-none" style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)">
              <option value="draft">Draft</option>
              <option value="published">Published</option>
              <option value="archived">Archived</option>
            </select>
          </div>
          <div class="flex items-center gap-2 pt-6">
            <input type="checkbox" id="featured" class="w-4 h-4 rounded" />
            <label for="featured" class="text-sm font-medium" style="color: var(--color-text-1)">Feature as Editor's Pick</label>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold mb-1" style="color: var(--color-text-1)">SEO Meta Title</label>
          <input type="text" id="seoTitle" placeholder="Leave empty to use Product Title" class="w-full px-4 py-2.5 rounded-lg border text-sm outline-none" style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)" />
        </div>

        <div>
          <label class="block text-xs font-semibold mb-1" style="color: var(--color-text-1)">SEO Meta Description</label>
          <textarea id="seoDescription" rows="2" placeholder="Leave empty to use Short Description" class="w-full px-4 py-2.5 rounded-lg border text-sm outline-none" style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"></textarea>
        </div>
      </div>

      <div id="form-error" class="hidden text-xs p-3 rounded-lg text-red-800 bg-red-50 border border-red-200"></div>

      <div class="flex items-center gap-3">
        <button
          type="submit"
          id="save-btn"
          class="px-6 py-3 rounded-xl font-semibold text-sm text-white transition-opacity hover:opacity-90"
          style="background: var(--color-accent)"
        >
          Save Product
        </button>
        <a href="/admin/products" class="px-5 py-3 rounded-xl border text-sm font-medium" style="border-color: var(--color-border); color: var(--color-text-2)">
          Cancel
        </a>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  import { api } from '../../../lib/api';

  async function init() {
    try {
      const res: any = await api.admin.categories.list();
      const select = document.getElementById('categoryId') as HTMLSelectElement;
      if (select && res.data) {
        res.data.forEach((c: any) => {
          const opt = document.createElement('option');
          opt.value = c._id;
          opt.textContent = c.name;
          select.appendChild(opt);
        });
      }
    } catch {}

    const form = document.getElementById('product-form') as HTMLFormElement;
    const errEl = document.getElementById('form-error') as HTMLDivElement;
    const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';
        errEl.className = 'hidden';

        const highlightsText = (document.getElementById('highlights') as HTMLTextAreaElement).value;
        const highlights = highlightsText.split('\n').map(s => s.trim()).filter(Boolean);
        const imageUrl = (document.getElementById('imageUrl') as HTMLInputElement).value;

        const data: any = {
          title: (document.getElementById('title') as HTMLInputElement).value,
          brand: (document.getElementById('brand') as HTMLInputElement).value,
          categoryId: (document.getElementById('categoryId') as HTMLSelectElement).value || undefined,
          shortDescription: (document.getElementById('shortDescription') as HTMLTextAreaElement).value,
          fullDescription: (document.getElementById('fullDescription') as HTMLTextAreaElement).value,
          status: (document.getElementById('status') as HTMLSelectElement).value,
          featured: (document.getElementById('featured') as HTMLInputElement).checked,
          seoTitle: (document.getElementById('seoTitle') as HTMLInputElement).value || undefined,
          seoDescription: (document.getElementById('seoDescription') as HTMLTextAreaElement).value || undefined,
          highlights,
          images: imageUrl ? [{ url: imageUrl, alt: '' }] : [],
        };

        try {
          const res = await api.admin.products.create(data);
          if (res.success) {
            window.location.href = '/admin/products';
          } else {
            throw new Error(res.message || 'Creation failed');
          }
        } catch (err: any) {
          errEl.className = 'block text-xs p-3 rounded-lg text-red-800 bg-red-50 border border-red-200';
          errEl.textContent = err.message || 'Error creating product';
        } finally {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Product';
        }
      });
    }
  }

  init();
</script>

