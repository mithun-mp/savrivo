---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard">
  <div class="space-y-8">
    <!-- Stat cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4" id="stats-grid">
      <div class="p-5 rounded-xl border" style="background: var(--color-surface); border-color: var(--color-border)">
        <p class="text-xs uppercase tracking-wider font-semibold" style="color: var(--color-text-2)">Total Products</p>
        <p class="text-2xl font-bold mt-2" id="stat-total" style="color: var(--color-text-1)">—</p>
      </div>
      <div class="p-5 rounded-xl border" style="background: var(--color-surface); border-color: var(--color-border)">
        <p class="text-xs uppercase tracking-wider font-semibold" style="color: var(--color-text-2)">Published</p>
        <p class="text-2xl font-bold mt-2 text-emerald-600" id="stat-published">—</p>
      </div>
      <div class="p-5 rounded-xl border" style="background: var(--color-surface); border-color: var(--color-border)">
        <p class="text-xs uppercase tracking-wider font-semibold" style="color: var(--color-text-2)">Drafts</p>
        <p class="text-2xl font-bold mt-2 text-amber-600" id="stat-drafts">—</p>
      </div>
      <div class="p-5 rounded-xl border" style="background: var(--color-surface); border-color: var(--color-border)">
        <p class="text-xs uppercase tracking-wider font-semibold" style="color: var(--color-text-2)">Categories</p>
        <p class="text-2xl font-bold mt-2" id="stat-categories" style="color: var(--color-text-1)">—</p>
      </div>
      <div class="p-5 rounded-xl border" style="background: var(--color-surface); border-color: var(--color-border)">
        <p class="text-xs uppercase tracking-wider font-semibold" style="color: var(--color-text-2)">Active Merchants</p>
        <p class="text-2xl font-bold mt-2" id="stat-merchants" style="color: var(--color-accent)">—</p>
      </div>
      <div class="p-5 rounded-xl border" style="background: var(--color-surface); border-color: var(--color-border)">
        <p class="text-xs uppercase tracking-wider font-semibold" style="color: var(--color-text-2)">Expired Offers</p>
        <p class="text-2xl font-bold mt-2 text-red-500" id="stat-expired">—</p>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="flex flex-wrap gap-3">
      <a
        href="/admin/products/new"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold text-white transition-opacity hover:opacity-90"
        style="background: var(--color-accent)"
      >
        + Add New Product
      </a>
      <a
        href="/admin/categories"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium border transition-colors hover:opacity-80"
        style="border-color: var(--color-border); color: var(--color-text-1)"
      >
        Manage Categories
      </a>
      <a
        href="/admin/merchants"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium border transition-colors hover:opacity-80"
        style="border-color: var(--color-border); color: var(--color-text-1)"
      >
        Manage Merchants
      </a>
      <a
        href="/admin/offers"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium border transition-colors hover:opacity-80"
        style="border-color: var(--color-border); color: var(--color-text-1)"
      >
        Manage Offers
      </a>
    </div>

    <!-- Recent Products Table -->
    <div class="rounded-xl border overflow-hidden" style="background: var(--color-surface); border-color: var(--color-border)">
      <div class="p-5 border-b flex items-center justify-between" style="border-color: var(--color-border)">
        <h2 class="text-sm font-semibold" style="color: var(--color-text-1)">Recent Products</h2>
        <a href="/admin/products" class="text-xs font-medium hover:underline" style="color: var(--color-accent)">View All →</a>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b text-xs uppercase tracking-wider" style="border-color: var(--color-border); color: var(--color-text-2)">
              <th class="p-4">Title</th>
              <th class="p-4">Status</th>
              <th class="p-4">Created</th>
              <th class="p-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="recent-products-tbody">
            <tr>
              <td colspan="4" class="p-4 text-center" style="color: var(--color-text-2)">Loading dashboard data...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { api } from '../../lib/api';

  async function loadDashboard() {
    try {
      const res: any = await api.admin.dashboard();
      if (res.data) {
        const stats = res.data.stats || {};
        const setVal = (id: string, val: any) => {
          const el = document.getElementById(id);
          if (el) el.textContent = val !== undefined ? String(val) : '0';
        };
        setVal('stat-total', stats.totalProducts);
        setVal('stat-published', stats.publishedProducts);
        setVal('stat-drafts', stats.draftProducts);
        setVal('stat-categories', stats.totalCategories);
        setVal('stat-merchants', stats.activeMerchants);
        setVal('stat-expired', stats.expiredOffers);

        const tbody = document.getElementById('recent-products-tbody');
        if (tbody) {
          const recents = res.data.recentProducts || [];
          if (recents.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" class="p-4 text-center text-xs" style="color: var(--color-text-2)">No products yet. Click "+ Add New Product" to start.</td></tr>';
          } else {
            tbody.innerHTML = recents.map((p: any) => `
              <tr class="border-b" style="border-color: var(--color-border)">
                <td class="p-4 font-medium" style="color: var(--color-text-1)">${p.title}</td>
                <td class="p-4">
                  <span class="text-xs px-2 py-0.5 rounded-full ${p.status === 'published' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}">
                    ${p.status}
                  </span>
                </td>
                <td class="p-4 text-xs" style="color: var(--color-text-2)">${new Date(p.createdAt).toLocaleDateString()}</td>
                <td class="p-4 text-right">
                  <a href="/admin/products/${p._id}" class="text-xs font-medium hover:underline" style="color: var(--color-accent)">Edit</a>
                </td>
              </tr>
            `).join('');
          }
        }
      }
    } catch (err) {
      console.error('Failed to load dashboard:', err);
    }
  }

  loadDashboard();
</script>

