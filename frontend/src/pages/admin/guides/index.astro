---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Buying Guide Management">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-xl font-bold" style="color: var(--color-text-1)">Buying Guides</h1>
        <p class="text-xs" style="color: var(--color-text-2)">Create original, research-backed purchase guides.</p>
      </div>
      <button id="add-guide-btn" class="px-4 py-2.5 rounded-lg text-sm font-semibold text-white transition-opacity hover:opacity-90" style="background: var(--color-accent)">
        + New Guide
      </button>
    </div>

    <!-- Guide Form Box -->
    <div id="guide-form-box" class="hidden p-6 rounded-xl border space-y-4" style="background: var(--color-surface); border-color: var(--color-border)">
      <h2 class="text-sm font-semibold" style="color: var(--color-text-1)">Write New Buying Guide</h2>
      <div>
        <label class="block text-xs font-semibold mb-1" style="color: var(--color-text-1)">Title *</label>
        <input type="text" id="g-title" placeholder="e.g. How to Choose Wireless Earbuds in India (2025)" class="w-full px-4 py-2 rounded-lg border text-sm outline-none" style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)" />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold mb-1" style="color: var(--color-text-1)">Category</label>
          <input type="text" id="g-category" placeholder="e.g. Electronics" class="w-full px-4 py-2 rounded-lg border text-sm outline-none" style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)" />
        </div>
        <div>
          <label class="block text-xs font-semibold mb-1" style="color: var(--color-text-1)">Status</label>
          <select id="g-status" class="w-full px-4 py-2 rounded-lg border text-sm outline-none" style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)">
            <option value="draft">Draft</option>
            <option value="published">Published</option>
          </select>
        </div>
      </div>
      <div>
        <label class="block text-xs font-semibold mb-1" style="color: var(--color-text-1)">Excerpt</label>
        <textarea id="g-excerpt" rows="2" class="w-full px-4 py-2 rounded-lg border text-sm outline-none" style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"></textarea>
      </div>
      <div>
        <label class="block text-xs font-semibold mb-1" style="color: var(--color-text-1)">Body Content (HTML)</label>
        <textarea id="g-body" rows="6" class="w-full px-4 py-2 rounded-lg border text-sm outline-none font-mono text-xs" style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"></textarea>
      </div>
      <div class="flex gap-2">
        <button id="g-save-btn" class="px-4 py-2 rounded-lg text-sm font-semibold text-white" style="background: var(--color-accent)">Save Guide</button>
        <button id="g-cancel-btn" class="px-4 py-2 rounded-lg border text-sm" style="border-color: var(--color-border); color: var(--color-text-2)">Cancel</button>
      </div>
    </div>

    <!-- Table -->
    <div class="rounded-xl border overflow-hidden" style="background: var(--color-surface); border-color: var(--color-border)">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b text-xs uppercase tracking-wider" style="border-color: var(--color-border); color: var(--color-text-2)">
            <th class="p-4">Title</th>
            <th class="p-4">Category</th>
            <th class="p-4">Status</th>
            <th class="p-4">Published</th>
          </tr>
        </thead>
        <tbody id="guides-tbody">
          <tr><td colspan="4" class="p-4 text-center text-xs" style="color: var(--color-text-2)">Loading guides...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<script>
  import { api } from '../../../lib/api';

  async function load() {
    const tbody = document.getElementById('guides-tbody');
    try {
      const res: any = await api.admin.guides.list();
      const list = res.data || [];
      if (!tbody) return;
      if (list.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="p-4 text-center text-xs" style="color: var(--color-text-2)">No guides published yet.</td></tr>';
        return;
      }
      tbody.innerHTML = list.map((g: any) => `
        <tr class="border-b" style="border-color: var(--color-border)">
          <td class="p-4 font-medium" style="color: var(--color-text-1)">
            <a href="/guides/${g.slug}" target="_blank" class="hover:underline flex items-center gap-1.5">
              ${g.title} ↗
            </a>
          </td>
          <td class="p-4 text-xs" style="color: var(--color-text-2)">${g.category || '—'}</td>
          <td class="p-4 text-xs">
            <span class="px-2 py-0.5 rounded-full ${g.status === 'published' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}">
              ${g.status}
            </span>
          </td>
          <td class="p-4 text-xs" style="color: var(--color-text-2)">${g.publishedAt ? new Date(g.publishedAt).toLocaleDateString() : '—'}</td>
        </tr>
      `).join('');
    } catch {
      if (tbody) tbody.innerHTML = '<tr><td colspan="4" class="p-4 text-center text-xs text-red-600">Failed to load guides.</td></tr>';
    }
  }

  const box = document.getElementById('guide-form-box');
  document.getElementById('add-guide-btn')?.addEventListener('click', () => box?.classList.remove('hidden'));
  document.getElementById('g-cancel-btn')?.addEventListener('click', () => box?.classList.add('hidden'));

  document.getElementById('g-save-btn')?.addEventListener('click', async () => {
    const title = (document.getElementById('g-title') as HTMLInputElement).value;
    const category = (document.getElementById('g-category') as HTMLInputElement).value;
    const status = (document.getElementById('g-status') as HTMLSelectElement).value;
    const excerpt = (document.getElementById('g-excerpt') as HTMLTextAreaElement).value;
    const body = (document.getElementById('g-body') as HTMLTextAreaElement).value;

    if (!title) return;

    await api.admin.guides.create({
      title,
      category,
      status,
      excerpt,
      body,
      publishedAt: status === 'published' ? new Date().toISOString() : undefined,
    });
    box?.classList.add('hidden');
    load();
  });

  load();
</script>

