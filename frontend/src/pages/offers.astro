---
import MainLayout from '../layouts/MainLayout.astro';
import { url } from '../lib/paths';
---

<MainLayout
  title="Live Offers — Coming Soon | SAVRIVO"
  description="Live offer discovery is coming to SAVRIVO. We're building a verified way to compare product offers across trusted retailers."
  canonicalUrl="https://savrivo.in/offers"
>
  <div class="section">
    <div class="container-content">
      <div class="max-w-xl mx-auto text-center py-16">
        <!-- Savi mark -->
        <div class="mx-auto mb-8 w-20 h-20">
          <svg width="80" height="80" viewBox="0 0 64 64" fill="none" aria-label="Savi — SAVRIVO discovery companion">
            <circle cx="32" cy="32" r="28" stroke="var(--color-accent)" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.3"/>
            <circle cx="32" cy="32" r="18" fill="var(--color-accent)" opacity="0.05"/>
            <circle cx="32" cy="32" r="8" fill="var(--color-accent)" opacity="0.08"/>
            <circle cx="32" cy="32" r="5" fill="var(--color-accent)" opacity="0.7"/>
            <line x1="32" y1="14" x2="32" y2="22" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="32" y1="42" x2="32" y2="50" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round" opacity="0.35"/>
            <line x1="14" y1="32" x2="22" y2="32" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round" opacity="0.35"/>
            <line x1="42" y1="32" x2="50" y2="32" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round" opacity="0.35"/>
            <circle cx="18" cy="18" r="2" fill="var(--color-accent-2)" opacity="0.5"/>
            <circle cx="46" cy="46" r="1.5" fill="var(--color-accent-2)" opacity="0.4"/>
          </svg>
        </div>

        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--color-accent)">Coming Soon</p>
        <h1 class="font-display text-3xl md:text-4xl font-bold mb-5" style="color: var(--color-text-1)">
          Live Offer Discovery
        </h1>
        <p class="text-base leading-relaxed mb-8" style="color: var(--color-text-2)">
          We're building a verified way to compare product offers across trusted retailers.<br />
          Live offer discovery is on its way.
        </p>
        <p class="text-sm leading-relaxed mb-10 p-5 rounded-xl" style="color: var(--color-text-2); background: var(--color-overlay); border: 1px solid var(--color-border)">
          SAVRIVO will only display offer data that has been verified through authorized affiliate programmes and feeds. We do not fabricate prices or availability.
        </p>

        <a
          href={url('/products')}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold text-white transition-opacity hover:opacity-90"
          style="background: var(--color-accent)"
        >
          Browse Products Instead
        </a>
      </div>
    </div>
  </div>
</MainLayout>

